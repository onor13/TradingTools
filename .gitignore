# Gradle cache and build directories
.gradle/
**/build/
.kotlin/

# Project specific cache
.gradletasknamecache

# Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper files needed for builds
!gradle-wrapper.jar
!gradle-wrapper.properties

# IntelliJ IDEA project files
.idea/
*.iml
*.iws

# Eclipse project files (if someone uses Eclipse)
.classpath
.project
.settings/

# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
.DS_Store
.DS_Store
